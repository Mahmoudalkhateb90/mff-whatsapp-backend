rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if false; // Only Admin SDK can modify users collection to prevent privilege escalation
    }

    match /campaigns/{campaignId} {
      allow read: if request.auth != null;
      allow write: if false; // Updated via Admin SDK increment
    }

    match /messageLogs/{logId} {
      allow read: if request.auth != null;
      allow write: if false; // Inserted via Admin SDK batching
    }
  }
}
